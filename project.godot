; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="test"
run/main_scene="uid://4n2j1r53pnr1"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://textures/icon.svg"

[autoload]

AppSave="*res://dx/runtime/scripts/save/save_manager.gd"
Popup="*res://dx/runtime/scripts/popup/popup_manager.gd"
DX="*res://dx/runtime/scripts/managers/dx_framework.gd"

[display]

window/size/viewport_width=430
window/size/viewport_height=932
window/size/borderless=true
window/size/transparent=true
window/size/extend_to_title=true
window/per_pixel_transparency/allowed=true

[editor]

version_control/autoload_on_startup=true

[internationalization]

locale/fallback="en"
locale/translations=PackedStringArray("res://translations/music_app.en.translation", "res://translations/music_app.zh.translation", "res://translations/music_app.zh_CN.translation")

[rendering]

