[sub_resource type="Shader" id="Shader_scanline_overlay"]
code = "shader_type canvas_item;

uniform float pulse = 0.0;
uniform float scanline_alpha = 0.075;
uniform float vignette_alpha = 0.42;
uniform vec4 tint : source_color = vec4(0.08, 0.9, 1.0, 1.0);

void fragment() {
	vec2 uv = UV;
	float line = step(0.72, fract(uv.y * 760.0 + TIME * 10.0));
	float fine_noise = fract(sin(dot(floor(uv * vec2(280.0, 520.0)), vec2(12.9898, 78.233))) * 43758.5453);
	float scan = line * scanline_alpha * (0.45 + fine_noise * 0.55);
	float dist = distance(uv, vec2(0.5, 0.5));
	float vignette = smoothstep(0.28, 0.82, dist) * vignette_alpha;
	float center_glow = smoothstep(0.8, 0.0, dist) * pulse * 0.055;
	vec3 color = mix(vec3(0.0), tint.rgb, scan * 0.75 + center_glow);
	COLOR = vec4(color, max(vignette, scan + center_glow));
}
"

