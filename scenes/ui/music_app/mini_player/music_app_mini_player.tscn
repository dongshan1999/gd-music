[sub_resource type="Shader" id="Shader_mini_cover_mask"]
code = "shader_type canvas_item;

void fragment() {
	vec2 centered_uv = UV * 2.0 - 1.0;
	if (dot(centered_uv, centered_uv) > 1.0) {
		discard;
	}
	COLOR = texture(TEXTURE, UV) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_mini_cover_mask"]
