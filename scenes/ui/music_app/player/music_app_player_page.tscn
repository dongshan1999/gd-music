[sub_resource type="Shader" id="Shader_player_cover_mask"]
code = "shader_type canvas_item;

void fragment() {
    vec2 p = UV;
    float radius = 0.075;
    vec2 q = abs(p - vec2(0.5)) - vec2(0.5 - radius);
    float distance_to_corner = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
    float antialias = max(fwidth(distance_to_corner), 0.001);
    float alpha = 1.0 - smoothstep(0.0, antialias, distance_to_corner);
    COLOR = texture(TEXTURE, UV) * COLOR;
    COLOR.a *= alpha;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_player_cover_mask"]
shader = SubResource("Shader_player_cover_mask")

