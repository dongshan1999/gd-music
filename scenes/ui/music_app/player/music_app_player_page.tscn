[sub_resource type="Shader" id="Shader_player_atmosphere_overlay"]
code = "shader_type canvas_item;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

void fragment() {
	vec2 uv = UV;
	vec2 center = uv - vec2(0.5, 0.46);
	float vignette = smoothstep(0.88, 0.28, length(center));
	float top_glow = smoothstep(0.72, 0.05, length((uv - vec2(0.28, 0.12)) * vec2(1.0, 1.9)));
	float gold_glow = smoothstep(0.62, 0.06, length((uv - vec2(0.82, 0.72)) * vec2(1.4, 1.0)));
	float flow = smoothstep(0.025, 0.0, abs(fract((uv.x + uv.y * 0.78) * 6.0 - TIME * 0.12) - 0.5));
	float scan = sin((uv.y + TIME * 0.015) * 980.0) * 0.5 + 0.5;
	float grain = hash(floor((uv + TIME * 0.004) * vec2(280.0, 520.0)));
	vec3 color = vec3(0.002, 0.005, 0.010);
	color += vec3(0.03, 0.82, 1.0) * top_glow * 0.16;
	color += vec3(1.0, 0.58, 0.16) * gold_glow * 0.13;
	color += vec3(0.08, 0.75, 0.95) * flow * 0.035;
	color += vec3(scan * 0.012 + grain * 0.014);
	COLOR = vec4(color, 0.72 - vignette * 0.18);
}
"

