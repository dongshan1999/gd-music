[gd_scene format=3]

[ext_resource type="Script" path="res://assets/scripts/ui/music_app/views/settings/music_app_download_management_view.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/textures/arrow-left.svg" id="2_back"]
[ext_resource type="Script" path="res://assets/scripts/ui/music_app/music_app_scroll.gd" id="90_scroll"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.160784, 0.160784, 0.168627, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_button"]

[node name="MusicAppDownloadManagementPage" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.055, 0.055, 0.065, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 14

[node name="DownloadVBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopRow" type="HBoxContainer" parent="Margin/DownloadVBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="DownloadManagementBackButton" type="Button" parent="Margin/DownloadVBox/TopRow"]
unique_name_in_owner = true
layout_mode = 2
icon = ExtResource("2_back")
custom_minimum_size = Vector2(44, 44)
theme_type_variation = "NavigationButton"
theme_override_constants/icon_max_width = 22
expand_icon = true
mouse_default_cursor_shape = 2
icon_alignment = 1
vertical_icon_alignment = 1
size_flags_vertical = 4

[node name="TitleLabel" type="Label" parent="Margin/DownloadVBox/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "音乐下载"
theme_override_font_sizes/font_size = 20
vertical_alignment = 1

[node name="PathCard" type="PanelContainer" parent="Margin/DownloadVBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="PathMargin" type="MarginContainer" parent="Margin/DownloadVBox/PathCard"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="PathVBox" type="VBoxContainer" parent="Margin/DownloadVBox/PathCard/PathMargin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PathTitleLabel" type="Label" parent="Margin/DownloadVBox/PathCard/PathMargin/PathVBox"]
layout_mode = 2
text = "下载目录"
theme_override_colors/font_color = Color(0.678431, 0.678431, 0.705882, 1)
theme_override_font_sizes/font_size = 12

[node name="DownloadPathLabel" type="Label" parent="Margin/DownloadVBox/PathCard/PathMargin/PathVBox"]
unique_name_in_owner = true
layout_mode = 2
text = "加载中…"
autowrap_mode = 3
theme_override_colors/font_color = Color(0.968627, 0.968627, 0.972549, 1)
theme_override_font_sizes/font_size = 13

[node name="PathButtonsRow" type="HBoxContainer" parent="Margin/DownloadVBox/PathCard/PathMargin/PathVBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="CopyPathButton" type="Button" parent="Margin/DownloadVBox/PathCard/PathMargin/PathVBox/PathButtonsRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_styles/normal = SubResource("StyleBoxEmpty_button")
theme_override_styles/disabled = SubResource("StyleBoxEmpty_button")
text = "复制路径"
theme_type_variation = "NavigationButton"

[node name="OpenDirectoryButton" type="Button" parent="Margin/DownloadVBox/PathCard/PathMargin/PathVBox/PathButtonsRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_styles/normal = SubResource("StyleBoxEmpty_button")
theme_override_styles/disabled = SubResource("StyleBoxEmpty_button")
text = "打开目录"
theme_type_variation = "NavigationButton"

[node name="DownloadSummaryLabel" type="Label" parent="Margin/DownloadVBox"]
unique_name_in_owner = true
layout_mode = 2
text = "共 0 首 / 占用 0 B"
theme_override_colors/font_color = Color(0.678431, 0.678431, 0.705882, 1)
theme_override_font_sizes/font_size = 12

[node name="DownloadScroll" type="ScrollContainer" parent="Margin/DownloadVBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 1
follow_focus = true

[node name="DownloadList" type="VBoxContainer" parent="Margin/DownloadVBox/DownloadScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="DownloadEmptyLabel" type="Label" parent="Margin/DownloadVBox/DownloadScroll/DownloadList"]
unique_name_in_owner = true
layout_mode = 2
text = "还没有下载任何音乐。去插件搜索页点播放器右上角的下载按钮即可离线保存。"
horizontal_alignment = 1
custom_minimum_size = Vector2(0, 180)
theme_override_colors/font_color = Color(0.6, 0.6, 0.64, 1)
autowrap_mode = 3
vertical_alignment = 1

[node name="ScrollInteraction" type="Node" parent="Margin/DownloadVBox/DownloadScroll"]
script = ExtResource("90_scroll")
scroll_container_path = NodePath("..")
